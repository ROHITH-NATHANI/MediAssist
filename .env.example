# Local demo only. Never use these defaults publicly.
POSTGRES_PASSWORD=local-demo-db-password
JWT_SECRET=local-demo-only-change-this-secret-123456789
APP_ENV=development
DEMO_SEED=true
INSTALL_AGENTS=true
AGENT_MODE=crewai
# Add your Groq API key; without a key the workflow falls back locally.
GROQ_API_KEY=
# Set to a currently supported Groq model (with groq/ prefix for CrewAI).
GROQ_MODEL=groq/llama-3.3-70b-versatile
